// auth.js – Sign up / Login logic (localStorage-based, client-side only)

// ── Helpers ──────────────────────────────────────────────────────────────────

function showMsg(id, text, type = 'error') {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = 'msg ' + type + ' show';
}
function hideMsg(id) {
  const el = document.getElementById(id);
  el.className = 'msg';
}

function getUsers() {
  return JSON.parse(localStorage.getItem('cm_users') || '[]');
}
function saveUsers(users) {
  localStorage.setItem('cm_users', JSON.stringify(users));
}

// ── Tab switcher ─────────────────────────────────────────────────────────────

function switchTab(tab) {
  ['login', 'signup'].forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('active', t === tab);
    document.getElementById('section-' + t).classList.toggle('active', t === tab);
  });
  hideMsg('login-err');
  hideMsg('su-err');
  hideMsg('su-ok');
}

// ── Password visibility toggle ───────────────────────────────────────────────

function togglePw(inputId, btn) {
  const inp = document.getElementById(inputId);
  const show = inp.type === 'password';
  inp.type = show ? 'text' : 'password';
  btn.textContent = show ? 'Hide' : 'Show';
}

// ── Password strength ────────────────────────────────────────────────────────

function checkStrength(pw) {
  const fill = document.getElementById('str-fill');
  let score = 0;
  if (pw.length >= 8)  score++;
  if (/[A-Z]/.test(pw)) score++;
  if (/[0-9]/.test(pw)) score++;
  if (/[^A-Za-z0-9]/.test(pw)) score++;
  const colors = ['#ff5370', '#ffb347', '#ffe066', '#00e5a0'];
  const widths  = ['25%', '50%', '75%', '100%'];
  fill.style.width      = score ? widths[score - 1] : '0%';
  fill.style.background = score ? colors[score - 1] : 'transparent';
}

// ── Sign Up ──────────────────────────────────────────────────────────────────

function doSignup() {
  hideMsg('su-err');
  hideMsg('su-ok');

  const username = document.getElementById('su-username').value.trim();
  const email    = document.getElementById('su-email').value.trim();
  const pw       = document.getElementById('su-pw').value;
  const confirm  = document.getElementById('su-confirm').value;

  // Validation
  if (!username) return showMsg('su-err', 'Username is required.');
  if (username.length < 3) return showMsg('su-err', 'Username must be at least 3 characters.');
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
    return showMsg('su-err', 'Enter a valid email address.');
  if (pw.length < 8) return showMsg('su-err', 'Password must be at least 8 characters.');
  if (pw !== confirm) return showMsg('su-err', 'Passwords do not match.');

  const users = getUsers();
  if (users.find(u => u.username.toLowerCase() === username.toLowerCase()))
    return showMsg('su-err', 'Username already taken.');
  if (users.find(u => u.email.toLowerCase() === email.toLowerCase()))
    return showMsg('su-err', 'Email already registered.');

  // Save (plain-text pw – client-side demo only, no server)
  users.push({ username, email, pw });
  saveUsers(users);

  showMsg('su-ok', '✅ Account created! Redirecting…', 'success');
  localStorage.setItem('cm_session', JSON.stringify({ username, email }));

  setTimeout(() => { window.location.href = 'dashboard.html'; }, 1000);
}

// ── Log In ───────────────────────────────────────────────────────────────────

function doLogin() {
  hideMsg('login-err');

  const identifier = document.getElementById('login-email').value.trim();
  const pw         = document.getElementById('login-pw').value;

  if (!identifier) return showMsg('login-err', 'Enter your email or username.');
  if (!pw)         return showMsg('login-err', 'Enter your password.');

  const users = getUsers();
  const user  = users.find(u =>
    u.email.toLowerCase() === identifier.toLowerCase() ||
    u.username.toLowerCase() === identifier.toLowerCase()
  );

  if (!user || user.pw !== pw)
    return showMsg('login-err', 'Invalid credentials. Try again.');

  localStorage.setItem('cm_session', JSON.stringify({ username: user.username, email: user.email }));
  window.location.href = 'dashboard.html';
}

// ── Guard: if already logged in, skip to dashboard ───────────────────────────
if (localStorage.getItem('cm_session')) {
  window.location.href = 'dashboard.html';
}
